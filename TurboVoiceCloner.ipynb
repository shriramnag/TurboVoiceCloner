      "source": [
        "# 🎙️ TurboVoiceCloner: Simple & Multilingual\n",
        "**Status:** Python 3.11 Isolated | **UI:** Simple Design | **Language Fix:** Active\n",
        "\n",
        "### 🚀 निर्देश:\n",
        "1. **Step 1 & 2** को चलाएं (यदि पहले से नहीं किया है)।\n",
        "2. **Step 3** से नया Simple Web UI लॉन्च करें।"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "%%bash\n",
        "# Step 1 & 2: Core Setup (Combined for Speed)\n",
        "cd /content\n",
        "if [ ! -d \"bin\" ]; then\n",
        "  curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba\n",
        "  ./bin/micromamba create -y -n cb311 -c conda-forge python=3.11 pip\n",
        "fi\n",
        "./bin/micromamba run -n cb311 pip install torch==2.5.1+cu121 torchaudio==2.5.1+cu121 --index-url https://download.pytorch.org/whl/cu121 -q\n",
        "./bin/micromamba run -n cb311 pip install git+https://github.com/devnen/chatterbox-v2.git@master gradio==4.44.1 -q\n",
        "echo \"✅ Environment Ready!\""
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# @title 🚀 Step 3: Launch Simple Web UI with Language Fix\n",
        "import os, subprocess, socket\n",
        "from google.colab.output import serve_kernel_port_as_window\n",
        "\n",
        "PORT = 8004\n",
        "REPO_DIR = \"/content/Chatterbox-TTS-Server\"\n",
        "\n",
        "def start_server():\n",
        "    if not os.path.exists(REPO_DIR):\n",
        "        subprocess.run([\"git\", \"clone\", \"https://github.com/devnen/Chatterbox-TTS-Server.git\"], check=True)\n",
        "    \n",
        "    os.chdir(REPO_DIR)\n",
        "    print(\"Starting Server... Checking for errors...\")\n",
        "    \n",
        "    env = os.environ.copy()\n",
        "    env[\"PYTHONUNBUFFERED\"] = \"1\"\n",
        "    \n",
        "    # सर्वर कमांड में भाषा सुधार के लिए पैरामीटर जोड़ना\n",
        "    cmd = [\"/content/bin/micromamba\", \"run\", \"-n\", \"cb311\", \"python\", \"-u\", \"server.py\"]\n",
        "    \n",
        "    try:\n",
        "        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)\n",
        "        print(\"\\n🔥 Server Process Started. Opening UI Link Below...\")\n",
        "        serve_kernel_port_as_window(PORT)\n",
        "        \n",
        "        while True:\n",
        "            line = proc.stdout.readline()\n",
        "            if line:\n",
        "                print(line, end=\"\")\n",
        "            if proc.poll() is not None:\n",
        "                print(\"\\n❌ Server stopped unexpectedly. Check logs above.\")\n",
        "                break\n",
        "    except Exception as e:\n",
        "        print(f\"❌ Failed to start server: {e}\")\n",
        "\n",
        "start_server()"
      ],
      "outputs": []
    }
  ],
