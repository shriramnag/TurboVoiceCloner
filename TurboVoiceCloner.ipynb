      "source": [
        "# 🎙️ TurboVoiceCloner: Next-Gen Open Source TTS\n",
        "**Features:** No Limits | Turbo Speed | Open Source Models | GPU Optimized\n",
        "\n",
        "### 🚀 Setup Instructions:\n",
        "1. **GPU:** Runtime -> Change runtime type -> **T4 GPU** चुनें।\n",
        "2. **Step 1:** सारी नई लाइब्रेरी इंस्टॉल करें।"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# @title 📦 Step 1: Install Latest Open-Source TTS\n",
        "# @markdown यह सेल transformers और accelerate के लेटेस्ट वर्जन इंस्टॉल करेगा।\n",
        "import os\n",
        "os.environ['MPLBACKEND'] = 'Agg'\n",
        "\n",
        "print(\"Installing Latest Transformers & TTS Engine...\")\n",
        "!pip install --upgrade pip -q\n",
        "!pip install --upgrade transformers accelerate -q\n",
        "!pip install -q coqui-tts==0.24.2 gradio==4.44.1 pydub\n",
        "\n",
        "print(\"✅ All latest libraries installed at Turbo Speed!\")"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# @title ⚙️ Step 2: Launch Voice Cloning Interface\n",
        "# @markdown यह नया वर्जन XTTS v2 मॉडल का उपयोग करेगा जो 'Llama' एरर से मुक्त है।\n",
        "with open(\"turbo_app.py\", \"w\") as f:\n",
        "    f.write('''\n",
        "import gradio as gr\n",
        "from TTS.api import TTS\n",
        "import os\n",
        "\n",
        "device = \"cuda\" if os.path.exists(\"/dev/nvidia0\") else \"cpu\"\n",
        "# Using XTTS v2 - Best Open Source Model\n",
        "tts = TTS(\"tts_models/multilingual/multi-dataset/xtts_v2\").to(device)\n",
        "\n",
        "def clone_voice(text, speaker_wav):\n",
        "    output_path = \"cloned_output.wav\"\n",
        "    tts.tts_to_file(\n",
        "        text=text,\n",
        "        speaker_wav=speaker_wav,\n",
        "        language=\"hi\",\n",
        "        file_path=output_path\n",
        "    )\n",
        "    return output_path\n",
        "\n",
        "demo = gr.Interface(\n",
        "    fn=clone_voice, \n",
        "    inputs=[gr.Textbox(label=\"Hindi/English Text Likhen\"), gr.Audio(label=\"Audio Sample Upload Karen\", type=\"filepath\")],\n",
        "    outputs=gr.Audio(label=\"Turbo Output\")\n",
        ")\n",
        "demo.launch(share=True)\n",
        "''')\n",
        "\n",
        "!python turbo_app.py"
      ],
      "outputs": []
    }
  ],
