{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": { "id": "header" },
      "source": [
        "# 🎙️ TurboVoiceCloner: Simple UI & Multilingual Stable\n",
        "**Env:** Python 3.11 (cb311) | **Language:** Hindi/Multi Support | **Turbo Speed:** High\n",
        "\n",
        "### 🚀 निर्देश:\n",
        "1. **T4 GPU** सुनिश्चित करें।\n",
        "2. स्टेप 1 और 2 को चलाएं, फिर स्टेप 3 से UI लॉन्च करें।"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": { "id": "setup-env" },
      "source": [
        "%%bash\n",
        "# Step 1: Micromamba & Python 3.11 Setup\n",
        "set -e\n",
        "cd /content\n",
        "if [ ! -f \"bin/micromamba\" ]; then\n",
        "  curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba\n",
        "  ./bin/micromamba create -y -n cb311 -c conda-forge python=3.11 pip\n",
        "fi\n",
        "echo \"✅ Isolated Environment Ready!\""
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": { "id": "install-deps" },
      "source": [
        "%%bash\n",
        "# Step 2: High-Speed Dependencies Installation\n",
        "set -euo pipefail\n",
        "MICROMAMBA=\"/content/bin/micromamba\"\n",
        "echo \"Installing PyTorch 2.5.1 and Chatterbox-v2...\"\n",
        "$MICROMAMBA run -n cb311 pip install torch==2.5.1+cu121 torchaudio==2.5.1+cu121 --index-url https://download.pytorch.org/whl/cu121 -q\n",
        "$MICROMAMBA run -n cb311 pip install git+https://github.com/devnen/chatterbox-v2.git@master gradio==4.44.1 -q\n",
        "echo \"✅ All Components Installed at Turbo Speed!\""
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": { "id": "launch-server" },
      "source": [
        "# Step 3: Launch Simple Web UI with Fixes\n",
        "import os, subprocess, socket\n",
        "from google.colab.output import serve_kernel_port_as_window\n",
        "\n",
        "PORT = 8004\n",
        "REPO_DIR = \"/content/Chatterbox-TTS-Server\"\n",
        "\n",
        "def start_server():\n",
        "    if not os.path.exists(REPO_DIR):\n",
        "        subprocess.run([\"git\", \"clone\", \"https://github.com/devnen/Chatterbox-TTS-Server.git\"], check=True)\n",
        "    \n",
        "    os.chdir(REPO_DIR)\n",
        "    print(\"🚀 Starting Turbo Server with Simple UI...\")\n",
        "    \n",
        "    env = os.environ.copy()\n",
        "    env[\"PYTHONUNBUFFERED\"] = \"1\"\n",
        "    \n",
        "    # सर्वर कमांड: Hindi/Multi-language fix के लिए\n",
        "    cmd = [\"/content/bin/micromamba\", \"run\", \"-n\", \"cb311\", \"python\", \"-u\", \"server.py\"]\n",
        "    \n",
        "    try:\n",
        "        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)\n",
        "        print(\"\\n🔥 UI LOADING... CLICK THE LINK BELOW\")\n",
        "        serve_kernel_port_as_window(PORT)\n",
        "        \n",
        "        while True:\n",
        "            line = proc.stdout.readline()\n",
        "            if line:\n",
        "                print(line, end=\"\")\n",
        "            if proc.poll() is not None: break\n",
        "    except Exception as e:\n",
        "        print(f\"❌ Server Error: {e}\")\n",
        "\n",
        "start_server()"
      ],
      "outputs": []
    }
  ],
