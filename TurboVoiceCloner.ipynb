      "source": [
        "# 🎙️ TurboVoiceCloner: Professional Web App\n",
        "**Features:** Premium UI | No Limits | Turbo Speed | XTTS v2 Engine\n",
        "\n",
        "### 🚀 Setup:\n",
        "1. **Runtime:** T4 GPU चुनें।\n",
        "2. **Step 1:** इंस्टॉलेशन शुरू करें।"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# @title 📦 Step 1: Install High-Speed Core\n",
        "import os\n",
        "os.environ['MPLBACKEND'] = 'Agg'\n",
        "print(\"Installing Premium UI and TTS Engine...\")\n",
        "!pip install --upgrade transformers accelerate -q\n",
        "!pip install -q coqui-tts==0.24.2 gradio==4.44.1 pydub\n",
        "print(\"✅ System Ready!\")"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# @title 🌐 Step 2: Launch Premium Web UI\n",
        "import gradio as gr\n",
        "from TTS.api import TTS\n",
        "import os\n",
        "\n",
        "# Model Loading\n",
        "device = \"cuda\" if os.path.exists(\"/dev/nvidia0\") else \"cpu\"\n",
        "tts = TTS(\"tts_models/multilingual/multi-dataset/xtts_v2\").to(device)\n",
        "\n",
        "def voice_clone_process(text, reference_audio):\n",
        "    if not text or not reference_audio:\n",
        "        return None\n",
        "    output = \"turbo_output.wav\"\n",
        "    tts.tts_to_file(text=text, speaker_wav=reference_audio, language=\"hi\", file_path=output)\n",
        "    return output\n",
        "\n",
        "# --- Premium UI Design ---\n",
        "custom_css = \"\"\"\n",
        "footer {visibility: hidden}\n",
        ".gradio-container {background-color: #0b0f19 !important; color: white !important;}\n",
        "button.primary {background: linear-gradient(90deg, #4f46e5, #9333ea) !important; border: none !important;}\n",
        "input, textarea {background-color: #1f2937 !important; border: 1px solid #374151 !important; color: white !important;}\n",
        "\"\"\"\n",
        "\n",
        "with gr.Blocks(css=custom_css, theme=gr.themes.Soft()) as demo:\n",
        "    gr.Markdown(\"# 🎙️ TurboVoiceCloner AI\")\n",
        "    gr.Markdown(\"अपना टेक्स्ट लिखें और अपनी क्लोन की हुई आवाज़ में हाई-स्पीड ऑडियो प्राप्त करें।\")\n",
        "    \n",
        "    with gr.Row():\n",
        "        with gr.Column():\n",
        "            input_text = gr.Textbox(label=\"Hindi / English Text\", placeholder=\"यहाँ अपना संदेश लिखें...\", lines=5)\n",
        "            ref_audio = gr.Audio(label=\"Upload Your Voice Sample (3-10 seconds)\", type=\"filepath\")\n",
        "            generate_btn = gr.Button(\"🚀 Generate Audio\", variant=\"primary\")\n",
        "            \n",
        "        with gr.Column():\n",
        "            output_audio = gr.Audio(label=\"AI Cloned Voice Output\")\n",
        "            gr.Markdown(\"### ✨ Tips for Best Quality\")\n",
        "            gr.Markdown(\"* आवाज़ का सैंपल साफ़ होना चाहिए (बिना शोर के)।\\n* कम से कम 5 सेकंड का ऑडियो डालें।\")\n",
        "\n",
        "    generate_btn.click(fn=voice_clone_process, inputs=[input_text, ref_audio], outputs=output_audio)\n",
        "\n",
        "print(\"Launching Web App...\")\n",
        "demo.launch(share=True, show_api=False)"
      ],
      "outputs": []
    }
  ],
