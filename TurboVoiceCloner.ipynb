      "source": [
        "# 🎙️ TurboVoiceCloner: Clean Installation Fix\n",
        "**Fix:** Auto-Numpy Resolution | Python 3.12 Compatible | Premium UI\n",
        "\n",
        "### 🚀 निर्देश (Instructions):\n",
        "1. **GPU:** सुनिश्चित करें कि T4 GPU चालू है।\n",
        "2. **Step 1:** यह सेल पुराने टकरावों को हटाकर नई लाइब्रेरी डालेगा।"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": { "id": "u8WiYQwXDw8Q" },
      "source": [
        "# @title 🚀 Step 1: Clean Installation (Modify Installation Cell)\n",
        "# @markdown यह सेल पुराने पैकेज को हटाकर सही वर्जन खुद चुनेगा।\n",
        "import os\n",
        "os.environ['MPLBACKEND'] = 'Agg'\n",
        "\n",
        "print(\"Cleaning old packages and resolving numpy conflicts...\")\n",
        "# पुराने numpy और TTS को हटाना\n",
        "!pip uninstall -y numpy transformers accelerate coqui-tts gradio\n",
        "\n",
        "print(\"Installing core dependencies at Turbo Speed...\")\n",
        "# pip को खुद बेस्ट वर्जन चुनने दें\n",
        "!pip install transformers accelerate coqui-tts gradio==4.44.1 pydub -q\n",
        "\n",
        "print(\"✅ Installation Successful! No more version conflicts.\")"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": { "id": "CgBmUAVjDw8T" },
      "source": [
        "# @title 🌐 Step 2: Launch Web UI (XTTS v2 Engine)\n",
        "# @markdown यह सेल अब बिना किसी एरर के वेब ऐप लॉन्च करेगा।\n",
        "import gradio as gr\n",
        "from TTS.api import TTS\n",
        "import os\n",
        "\n",
        "device = \"cuda\" if os.path.exists(\"/dev/nvidia0\") else \"cpu\"\n",
        "\n",
        "try:\n",
        "    print(\"Loading XTTS v2 Model...\")\n",
        "    tts = TTS(\"tts_models/multilingual/multi-dataset/xtts_v2\").to(device)\n",
        "\n",
        "    def voice_clone_process(text, reference_audio):\n",
        "        if not text or not reference_audio:\n",
        "            return None\n",
        "        output = \"turbo_output.wav\"\n",
        "        tts.tts_to_file(text=text, speaker_wav=reference_audio, language=\"hi\", file_path=output)\n",
        "        return output\n",
        "\n",
        "    # Premium UI Design\n",
        "    with gr.Blocks(theme=gr.themes.Soft()) as demo:\n",
        "        gr.Markdown(\"# 🎙️ TurboVoiceCloner AI (Fixed Version)\")\n",
        "        with gr.Row():\n",
        "            with gr.Column():\n",
        "                txt = gr.Textbox(label=\"Write Text (Hindi/English)\", lines=4)\n",
        "                aud = gr.Audio(label=\"Upload Voice Sample\", type=\"filepath\")\n",
        "                btn = gr.Button(\"🚀 Generate Audio\", variant=\"primary\")\n",
        "            with gr.Column():\n",
        "                out = gr.Audio(label=\"AI Cloned Voice\")\n",
        "        \n",
        "        btn.click(fn=voice_clone_process, inputs=[txt, aud], outputs=out)\n",
        "\n",
        "    demo.launch(share=True)\n",
        "except Exception as e:\n",
        "    print(f\"❌ Error: {e}\")"
      ],
      "outputs": []
    }
  ],
