      "source": [
        "# 🎙️ TurboVoiceCloner: Micromamba & Chatterbox v2\n",
        "**Status:** Isolated Environment (cb311) | **Engine:** Chatterbox-v2\n",
        "\n",
        "### 🚀 सेटअप निर्देश:\n",
        "1. **GPU:** T4 GPU चालू करें।\n",
        "2. **Step 1:** Micromamba और Python 3.11 सेटअप करें।"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "%%bash\n",
        "# @title 📦 Step 1: Setup Micromamba Environment\n",
        "set -e\n",
        "cd /content\n",
        "\n",
        "# Micromamba डाउनलोड और इंस्टॉल करें\n",
        "curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba\n",
        "\n",
        "# नया अलग वातावरण (cb311) बनाएं\n",
        "./bin/micromamba create -y -n cb311 -c conda-forge python=3.11 pip\n",
        "\n",
        "echo \"✅ Micromamba ready at /content/bin/micromamba\"\n",
        "echo \"✅ Env created: cb311\""
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "%%bash\n",
        "# @title 🚀 Step 2: Install Core Dependencies (Turbo Speed)\n",
        "set -euo pipefail\n",
        "cd /content\n",
        "MICROMAMBA=\"/content/bin/micromamba\"\n",
        "\n",
        "echo \"Upgrading pip and installing PyTorch 2.5.1...\"\n",
        "$MICROMAMBA run -n cb311 pip install -U pip setuptools wheel -q\n",
        "$MICROMAMBA run -n cb311 pip install torch==2.5.1+cu121 torchaudio==2.5.1+cu121 --index-url https://download.pytorch.org/whl/cu121 -q\n",
        "\n",
        "echo \"Installing Chatterbox-v2 from Github...\"\n",
        "$MICROMAMBA run -n cb311 pip install --no-cache-dir --upgrade git+https://github.com/devnen/chatterbox-v2.git@master -q\n",
        "echo \"✅ Installation complete!\""
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# @title ⚙️ Step 3: Launch Server with Live Logs\n",
        "import os, time, subprocess, socket, requests\n",
        "from pathlib import Path\n",
        "from google.colab.output import serve_kernel_port_as_window\n",
        "\n",
        "PORT = 8004\n",
        "REPO_DIR = \"/content/Chatterbox-TTS-Server\"\n",
        "LOG_STDOUT = \"/content/chatterbox_server_stdout.log\"\n",
        "\n",
        "def port_open(host=\"127.0.0.1\", port=PORT):\n",
        "    try:\n",
        "        with socket.create_connection((host, port), timeout=0.5): return True\n",
        "    except: return False\n",
        "\n",
        "# Clone repo and install requirements\n",
        "if not os.path.exists(REPO_DIR):\n",
        "    subprocess.run([\"git\", \"clone\", \"https://github.com/devnen/Chatterbox-TTS-Server.git\"], check=True)\n",
        "\n",
        "os.chdir(REPO_DIR)\n",
        "subprocess.run([\"/content/bin/micromamba\", \"run\", \"-n\", \"cb311\", \"pip\", \"install\", \"fastapi\", \"uvicorn[standard]\", \"pyyaml\", \"soundfile\", \"librosa\", \"python-multipart\", \"requests\", \"pydub\", \"audiotsm\", \"praat-parselmouth\"], check=False)\n",
        "\n",
        "print(\"🚀 Starting server with LIVE logs...\")\n",
        "env = os.environ.copy()\n",
        "env[\"PYTHONUNBUFFERED\"] = \"1\"\n",
        "\n",
        "proc = subprocess.Popen([\"/content/bin/micromamba\", \"run\", \"-n\", \"cb311\", \"python\", \"-u\", \"server.py\"], \n",
        "                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)\n",
        "\n",
        "shown_link = False\n",
        "while True:\n",
        "    line = proc.stdout.readline()\n",
        "    if line:\n",
        "        print(line, end=\"\")\n",
        "        if \"Uvicorn running on\" in line or port_open():\n",
        "            if not shown_link:\n",
        "                print(\"\\n=== Server is Reachable ===\")\n",
        "                serve_kernel_port_as_window(PORT)\n",
        "                shown_link = True\n",
        "    if proc.poll() is not None: break"
      ],
      "outputs": []
    }
  ],
