      "source": [
        "# 🎙️ TurboVoiceCloner: Error-Free TTS Setup\n",
        "**Status:** High-Speed | **Fix:** Import & Red Bar Error Fixed\n",
        "\n",
        "### 🛠️ निर्देश:\n",
        "1. सुनिश्चित करें कि **GPU (T4)** चालू है।\n",
        "2. स्टेप 1 और 2 को क्रम से चलाएं।"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# @title 🚀 Step 1: Install & Repair Chatterbox\n",
        "import os\n",
        "os.environ['MPLBACKEND'] = 'Agg'\n",
        "\n",
        "print(\"Installing Core Components and fixing ImportErrors...\")\n",
        "!git clone https://github.com/devnen/Chatterbox-TTS-Server.git 2>/dev/null || echo \"Repo exists\"\n",
        "%cd /content/Chatterbox-TTS-Server\n",
        "\n",
        "# Stable Dependencies\n",
        "!pip install torch==2.5.1+cu121 torchaudio==2.5.1+cu121 --index-url https://download.pytorch.org/whl/cu121 -q\n",
        "!pip install git+https://github.com/devnen/chatterbox.git -q\n",
        "!pip install fastapi uvicorn pydub gradio==4.44.1 python-multipart requests librosa -q\n",
        "\n",
        "# @markdown **Fixing 'chatterbox-turbo' missing error**\n",
        "with open(\"fix_engine.py\", \"w\") as f:\n",
        "    f.write('''\n",
        "import os\n",
        "target_file = '/content/Chatterbox-TTS-Server/engine.py'\n",
        "if os.path.exists(target_file):\n",
        "    with open(target_file, 'r') as file: data = file.read()\n",
        "    # Force correct model selector\n",
        "    data = data.replace(\"'chatterbox-turbo'\", \"'chatterbox-original'\")\n",
        "    with open(target_file, 'w') as file: file.write(data)\n",
        "''')\n",
        "!python3 fix_engine.py\n",
        "print(\"✅ All Errors Patched!\")"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "source": [
        "# @title ⚙️ Step 2: Start Server (Safe Mode)\n",
        "import threading, time, uvicorn, gc\n",
        "from google.colab.output import serve_kernel_port_as_window\n",
        "\n",
        "!fuser -k 8004/tcp 2>/dev/null || echo \"Port clear\"\n",
        "gc.collect()\n",
        "\n",
        "def run_server():\n",
        "    from server import app\n",
        "    # Using --reload and log-level info to trace any remaining issues\n",
        "    uvicorn.run(app, host=\"0.0.0.0\", port=8004, log_level=\"info\")\n",
        "\n",
        "print(\"🚀 Starting TTS server... 35 seconds wait for GPU...\")\n",
        "thread = threading.Thread(target=run_server, daemon=True)\n",
        "thread.start()\n",
        "\n",
        "time.sleep(35)\n",
        "print(\"🎉 Server ready! Click below to open UI:\")\n",
        "serve_kernel_port_as_window(8004)"
      ],
      "outputs": []
    }
  ],
