      "source": [
        "# 🎙️ Chatterbox Multilingual: Modern Simple UI\n",
        "**Project:** Chatterbox Multilingual | **Status:** Turbo Speed Active\n",
        "\n",
        "### 🚀 निर्देश:\n",
        "1. सुनिश्चित करें कि **T4 GPU** चालू है।\n",
        "2. सभी स्टेप्स को क्रम से चलाएं।"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": { "id": "install-core" },
      "source": [
        "# @title 📦 Step 1: Install Chatterbox Multilingual\n",
        "import os, time\n",
        "print(\"📥 Installing dependencies at Turbo Speed...\")\n",
        "\n",
        "!wget https://raw.githubusercontent.com/NeuralFalconYT/Chatterbox-Multilingual/refs/heads/main/app.py -q\n",
        "!git clone https://github.com/resemble-ai/chatterbox.git -q\n",
        "!rm -f /content/chatterbox/src/chatterbox/__init__.py\n",
        "!wget -O /content/chatterbox/src/chatterbox/__init__.py https://raw.githubusercontent.com/NeuralFalconYT/Chatterbox-Multilingual/refs/heads/main/__init__.py -q\n",
        "\n",
        "dependencies = [\n",
        "    \"numpy~=1.26.0\", \"resampy==0.4.3\", \"librosa==0.11.0\", \"s3tokenizer==0.2.0\",\n",
        "    \"torchcodec==0.8.1\", \"transformers==4.46.3\", \"diffusers==0.29.0\",\n",
        "    \"resemble-perth==1.0.1\", \"omegaconf==2.3.0\", \"conformer==0.3.2\",\n",
        "    \"safetensors==0.5.3\", \"sentencex==0.6.1\", \"pydub==0.25.1\", \"soundfile==0.13.1\"\n",
        "]\n",
        "\n",
        "!pip install {' '.join(dependencies)} -q\n",
        "\n",
        "print(\"✅ Installation complete. Restarting session in 2 seconds...\")\n",
        "time.sleep(2)\n",
        "os.kill(os.getpid(), 9)"
      ],
      "outputs": []
    },
    {
